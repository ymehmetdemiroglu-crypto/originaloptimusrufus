# ──────────────────────────────────────────────────────────────
# Required API keys
# ──────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=                    # Required — LLM scoring + email drafting
APIFY_TOKEN=                           # Required — Amazon scraping
APOLLO_API_KEY=                        # Required — Contact enrichment + sequences

# ──────────────────────────────────────────────────────────────
# Supabase (cloud PostgreSQL, primary data store)
# ──────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=

# ──────────────────────────────────────────────────────────────
# Apollo sequence (required for outreach automation)
# ──────────────────────────────────────────────────────────────
APOLLO_SEQUENCE_ID=
APOLLO_SEND_FROM_EMAIL_ACCOUNT_ID=

# ──────────────────────────────────────────────────────────────
# Optional — LLM model overrides
# ──────────────────────────────────────────────────────────────
OPENROUTER_MODEL=deepseek/deepseek-v4-pro
OPENROUTER_DRAFT_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_API_KEY and OPENROUTER_BASE_URL default to the values in config.py

# ──────────────────────────────────────────────────────────────
# Optional — Claude API (set USE_CLAUDE_EMAIL=true to switch)
# ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
USE_CLAUDE_EMAIL=false
CLAUDE_EMAIL_MODEL=claude-haiku-4-5-20251001

# ──────────────────────────────────────────────────────────────
# Optional — concurrency / performance tuning
# ──────────────────────────────────────────────────────────────
MAX_LLM_CONCURRENCY=25
MAX_APOLLO_CONCURRENCY=5
MASS_PROSPECT_PER_NICHE=25
APIFY_BATCH_SIZE=200
LLM_REQUEST_TIMEOUT_S=120
APOLLO_REQUEST_TIMEOUT_S=30
EMAIL_MINI_BATCH_SIZE=3

# ──────────────────────────────────────────────────────────────
# Optional — prompt / rule file paths (for hot-reload without code changes)
# ──────────────────────────────────────────────────────────────
RUFUS_PROMPT_PATH=prompts/rufus_system_prompt.txt
COLD_EMAIL_RULES_PATH=rules/banned_phrases.json

# ──────────────────────────────────────────────────────────────
# Backend Rufus/COSMO Optimization Engine
# ──────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
BACKEND_API_KEY=
USE_BACKEND_SCORING=false

# ──────────────────────────────────────────────────────────────
# Optional — observability
# ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_OUTPUT=stdout
