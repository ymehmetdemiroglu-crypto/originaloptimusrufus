# =============================================================================
# Optimus Rufus — Consolidated Environment Configuration Template
# =============================================================================
# Copy this file to .env in the root directory (for local docker-compose stack)
# or backend/.env / acquisition-tool/.env for standalone service configurations.

# -----------------------------------------------------------------------------
# 🌐 Domain & VPS Settings (Production Deployment)
# -----------------------------------------------------------------------------
DOMAIN=audit.optimusrufus.com

# -----------------------------------------------------------------------------
# 🤖 Core AI Service Credentials
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# -----------------------------------------------------------------------------
# ⚡ Supabase Credentials (Pipeline Database & Vector Realtime API)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key_here

# -----------------------------------------------------------------------------
# 📡 Outbound Prospecting & Lead Enrichment Integrations (Apollo + Apify)
# -----------------------------------------------------------------------------
APIFY_TOKEN=your_apify_api_token_here
APOLLO_API_KEY=your_apollo_api_key_here
APOLLO_SEQUENCE_ID=your_apollo_outbound_sequence_id_here
APOLLO_GENERIC_SEQUENCE_ID=your_apollo_generic_sequence_id_here
APOLLO_SEND_FROM_EMAIL_ACCOUNT_ID=your_apollo_send_from_account_id_here

# -----------------------------------------------------------------------------
# 🔐 Webhook Verification Secrets & Slugs
# -----------------------------------------------------------------------------
CALENDLY_URL=https://calendly.com/optimusrufus/audit
CALENDLY_WEBHOOK_SECRET=your_calendly_signing_secret_here
APOLLO_WEBHOOK_SECRET=your_apollo_webhook_secret_here

# -----------------------------------------------------------------------------
# 👤 Admin Control Panel Configurations
# -----------------------------------------------------------------------------
ADMIN_API_KEY=your_strong_admin_api_key_here
ADMIN_PASSWORD=your_secure_admin_login_password_here
ADMIN_PASSWORD_HASH=your_pbkdf2_sha256_hash_here

# -----------------------------------------------------------------------------
# ⚙️ Local Development Settings
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MOCK_EMBEDDINGS=true
CALCULATOR_BASE_URL=http://localhost:3000
PITCH_PAGE_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 📦 Amazon Selling Partner API (SP-API) Configuration
# -----------------------------------------------------------------------------
AMAZON_SELLER_ID=your_seller_id_here
LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxxxxxxxxxxxxxx
LWA_CLIENT_SECRET=amzn1.oa2-cs.v1.xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SP_API_REFRESH_TOKEN=Atzr|xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SP_API_REGION=US

# -----------------------------------------------------------------------------
# ⏰ Autonomous Agent Orchestration Pipeline Settings
# -----------------------------------------------------------------------------
AGENT_ENABLED=false
AGENT_AUTO_SCRAPE=false
AGENT_AUTO_ENRICH=false
AGENT_AUTO_SCORE=false
AGENT_AUTO_DRAFT=false
AGENT_AUTO_SEQUENCE=false
AGENT_AUTO_REPLY=false

AGENT_MAX_DAILY_SEQUENCES=50
AGENT_REPLY_CONFIDENCE_THRESHOLD=0.85
AGENT_MAX_AUTO_REPLIES_PER_DAY=20

# Daily Schedule UTC Run times (HH:MM format)
AGENT_SCHEDULE_SCRAPE_UTC=06:00
AGENT_SCHEDULE_ENRICH_UTC=07:30
AGENT_SCHEDULE_SCORE_UTC=08:00
AGENT_SCHEDULE_DRAFT_UTC=08:30
AGENT_SCHEDULE_SEQUENCE_UTC=09:00
AGENT_SCHEDULE_REPLY_UTC=09:30
AGENT_SCHEDULE_SNAPSHOT_UTC=23:00

# Pipeline Limit Constraints & Category Focus
AGENT_SCRAPE_LIMIT_PER_CATEGORY=50
AGENT_SCRAPE_CATEGORIES_PER_RUN=2
OUTREACH_CATEGORY=supplements
DAILY_ENRICH_LIMIT=20
AGENT_INTERVAL_HOURS=24
RUN_ON_STARTUP=true
EMAIL_MINI_BATCH_SIZE=3

# 📢 Slack Notifications & Alerts
SLACK_WEBHOOK_URL=your_slack_webhook_here
ADMIN_EMAIL=yahya@optimusrufus.com
