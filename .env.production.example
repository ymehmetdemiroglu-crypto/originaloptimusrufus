# =============================================================================
# Optimus Rufus v2 — Production Environment Configuration Example
# Copy this file to .env on your Hetzner VPS and customize.
# =============================================================================

# Domain Configuration (for SSL & Caddy TLS)
DOMAIN=audit.optimusrufus.com

# Core AI Credentials
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase Production Database & Realtime API
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

# Outbound prospecting integrations (Apollo + Apify)
APIFY_TOKEN=your_apify_api_token_here
APOLLO_API_KEY=your_apollo_api_key_here
APOLLO_SEQUENCE_ID=your_apollo_outbound_sequence_id
APOLLO_SEND_FROM_EMAIL_ACCOUNT_ID=your_apollo_sender_email_account_id

# Admin Authentication
ADMIN_API_KEY=your_strong_admin_api_key_here
ADMIN_PASSWORD=your_secure_admin_login_password_here

# Calendly webhook & booking slug configuration
CALENDLY_URL=https://calendly.com/optimusrufus/audit
CALENDLY_WEBHOOK_SECRET=your_calendly_signing_secret_here

# Base URL configurations for personalized email redirection links
CALCULATOR_BASE_URL=https://audit.optimusrufus.com
PITCH_PAGE_BASE_URL=https://audit.optimusrufus.com

# Pipeline Tuning Settings
EMAIL_MINI_BATCH_SIZE=3
DAILY_ENRICH_LIMIT=20
AGENT_INTERVAL_HOURS=24
OUTREACH_CATEGORY=supplements
RUN_ON_STARTUP=true
